{
  "name": "@mednova/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --env-file=../../.env --import tsx/esm --watch src/index.ts",
    "start": "node --env-file=.env --env-file=../../.env --import tsx/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "node --env-file=.env --import tsx/esm src/scripts/seedDemo.ts"
  },
  "dependencies": {
    "@mednova/types": "workspace:*",
    "@mednova/contracts": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@supabase/supabase-js": "^2.49.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
